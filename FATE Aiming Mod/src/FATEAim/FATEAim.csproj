<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion>
  <AssemblyName>mikhailkillszombies.FateAiming</AssemblyName><Version>0.5.6</Version>
